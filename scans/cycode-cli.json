,"kind":"first-observed"}]},"advisories":[],"risk":0.23583750000000003},"relatedVulnerabilities":[{"id":"CVE-2026-44431","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-44431","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/urllib3/urllib3/security/advisories/GHSA-qccp-gfcp-xxvc","https://lists.debian.org/debian-lts-announce/2026/06/msg00040.html"],"description":"urllib3 is an HTTP client library for Python. From 1.23 to before 2.7.0, cross-origin redirects followed from the low-level API via ProxyManager.connection_from_url().urlopen(..., assert_same_host=False) still forward these sensitive headers. This vulnerability is fixed in 2.7.0.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":8.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-44431","epss":0.00331,"percentile":0.26218,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-44431","cwe":"CWE-200","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"urllib3","version":"2.6.3"}},"found":{"vulnerabilityID":"GHSA-qccp-gfcp-xxvc","versionConstraint":">=1.23,<2.7.0 (python)"},"fix":{"suggestedVersion":"2.7.0"}}],"artifact":{"id":"pkg:pypi/urllib3@2.6.3?package-id=e2ece809fea9628e","name":"urllib3","version":"2.6.3","type":"python","locations":[{"path":"/poetry.lock","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python:urllib3:2.6.3:*:*:*:*:*:*:*"],"purl":"pkg:pypi/urllib3@2.6.3","upstreams":[]}},{"vulnerability":{"id":"GHSA-h35f-9h28-mq5c","dataSource":"https://github.com/advisories/GHSA-h35f-9h28-mq5c","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/pypa/setuptools/security/advisories/GHSA-h35f-9h28-mq5c","https://nvd.nist.gov/vuln/detail/CVE-2026-59890","https://github.com/pypa/setuptools/commit/dd9f436a36486b4cb8a4c70a2321548b0be09b8f","https://github.com/pypa/advisory-database/tree/main/vulns/setuptools/PYSEC-2026-3447.yaml","https://github.com/pypa/setuptools/releases/tag/v83.0.0"],"description":"setuptools: MANIFEST.in exclusion bypass in sdist via Unicode normalization collision (NFC/NFD) on macOS APFS/HFS+","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":1.9,"impactScore":4.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-59890","epss":0.00405,"percentile":0.33994,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-59890","cwe":"CWE-176","source":"security-advisories@github.com","type":"Primary"},{"cve":"CVE-2026-59890","cwe":"CWE-697","source":"security-advisories@github.com","type":"Primary"}],"fix":{"versions":["83.0.0"],"state":"fixed","available":[{"version":"83.0.0","date":"2026-07-22","kind":"first-observed"}]},"advisories":[],"risk":0.22477499999999997},"relatedVulnerabilities":[{"id":"CVE-2026-59890","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-59890","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/pypa/setuptools/commit/dd9f436a36486b4cb8a4c70a2321548b0be09b8f","https://github.com/pypa/setuptools/releases/tag/v83.0.0","https://github.com/pypa/setuptools/security/advisories/GHSA-h35f-9h28-mq5c"],"description":"setuptools is a package that allows users to download, build, install, upgrade, and uninstall Python packages. Prior to 83.0.0, FileList applied MANIFEST.in exclude, global-exclude, recursive-exclude, and prune directives by matching compiled glob patterns against on-disk file names without Unicode normalization, so on macOS APFS or HFS+ an NFD file name could bypass an NFC exclusion rule and be packed into a source distribution. This issue is fixed in version 83.0.0.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":1.9,"impactScore":4.3},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-59890","epss":0.00405,"percentile":0.33994,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-59890","cwe":"CWE-176","source":"security-advisories@github.com","type":"Primary"},{"cve":"CVE-2026-59890","cwe":"CWE-697","source":"security-advisories@github.com","type":"Primary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"setuptools","version":"82.0.1"}},"found":{"vulnerabilityID":"GHSA-h35f-9h28-mq5c","versionConstraint":"<83.0.0 (python)"},"fix":{"suggestedVersion":"83.0.0"}}],"artifact":{"id":"pkg:pypi/setuptools@82.0.1?package-id=ba2ead0156c8bccc","name":"setuptools","version":"82.0.1","type":"python","locations":[{"path":"/poetry.lock","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python:setuptools:82.0.1:*:*:*:*:*:*:*"],"purl":"pkg:pypi/setuptools@82.0.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-428g-f7cq-pgp5","dataSource":"https://github.com/advisories/GHSA-428g-f7cq-pgp5","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/marshmallow-code/marshmallow/security/advisories/GHSA-428g-f7cq-pgp5","https://github.com/marshmallow-code/marshmallow/commit/d24a0c9df061c4daa92f71cf85aca25b83eee508","https://nvd.nist.gov/vuln/detail/CVE-2025-68480"],"description":"Marshmallow has DoS in Schema.load(many)","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-68480","epss":0.00289,"percentile":0.21584,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2025-68480","cwe":"CWE-405","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["4.1.2"],"state":"fixed","available":[{"version":"4.1.2","date":"2025-12-23","kind":"first-observed"}]},"advisories":[],"risk":0.148835},"relatedVulnerabilities":[{"id":"CVE-2025-68480","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-68480","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/marshmallow-code/marshmallow/commit/d24a0c9df061c4daa92f71cf85aca25b83eee508","https://github.com/marshmallow-code/marshmallow/security/advisories/GHSA-428g-f7cq-pgp5"],"description":"Marshmallow is a lightweight library for converting complex objects to and from simple Python datatypes. In versions from 3.0.0rc1 to before 3.26.2 and from 4.0.0 to before 4.1.2, Schema.load(data, many=True) is vulnerable to denial of service attacks. A moderately sized request can consume a disproportionate amount of CPU time. This issue has been patched in version 3.26.2 and 4.1.2.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:L","metrics":{"baseScore":5.3,"exploitabilityScore":3.9,"impactScore":1.5},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-68480","epss":0.00289,"percentile":0.21584,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2025-68480","cwe":"CWE-405","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"marshmallow","version":"4.0.1"}},"found":{"vulnerabilityID":"GHSA-428g-f7cq-pgp5","versionConstraint":">=4.0.0,<4.1.2 (python)"},"fix":{"suggestedVersion":"4.1.2"}}],"artifact":{"id":"pkg:pypi/marshmallow@4.0.1?package-id=1e2103a5af62b159","name":"marshmallow","version":"4.0.1","type":"python","locations":[{"path":"/poetry.lock","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:marshmallow_project:marshmallow:4.0.1:*:*:*:*:python:*:*"],"purl":"pkg:pypi/marshmallow@4.0.1","upstreams":[]}},{"vulnerability":{"id":"GHSA-g6cj-pr64-35w5","dataSource":"https://github.com/advisories/GHSA-g6cj-pr64-35w5","namespace":"github:language:python","severity":"High","urls":["https://github.com/pyca/cryptography/security/advisories/GHSA-g6cj-pr64-35w5","https://github.com/pyca/cryptography/pull/15369","https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f"],"description":"cryptography: PKCS#7 EnvelopedData decryption exposes a Bleichenbacher oracle through distinguishable errors and timing","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":8.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-69247","epss":0.00175,"percentile":0.07333,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-69247","cwe":"CWE-208","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-69247","cwe":"CWE-209","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["50.0.0"],"state":"fixed","available":[{"version":"50.0.0","date":"2026-08-04","kind":"first-observed"}]},"advisories":[],"risk":0.137375},"relatedVulnerabilities":[{"id":"CVE-2026-69247","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-69247","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/pyca/cryptography/commit/53fccd93413a8d7f07d6d8999681f27b75cffa3f","https://github.com/pyca/cryptography/pull/15369","https://github.com/pyca/cryptography/security/advisories/GHSA-g6cj-pr64-35w5"],"description":"cryptography is a package designed to expose cryptographic primitives and recipes to Python developers. From 44.0.0 until 50.0.0, pkcs7_decrypt_der, pkcs7_decrypt_pem, and pkcs7_decrypt_smime reported the outcome of decrypting a RecipientInfo's encryptedKey in several distinguishable ways, one of which disclosed the exact length recovered from the RSA operation. The same distinction was also observable by timing. An application that decrypts attacker-supplied EnvelopedData and reflects the outcome gives the attacker a Bleichenbacher oracle against the content-encryption key. Decryption ran as RSA PKCS#1 v1.5 decrypt of encryptedKey, build an AES cipher from the result, then AES-CBC decrypt and PKCS#7 unpad. Invalid RSA padding, a valid padding with a bad key length, a correct length with a wrong key, and the real key each failed or succeeded differently. Case 1 is reachable only where the linked library lacks implicit rejection: OpenSSL 3.0 and 3.1, LibreSSL, and BoringSSL. Exploitation requires a service that auto-decrypts untrusted EnvelopedData matching the victim certificate and answers adaptively at high volume, such as an S/MIME gateway or mail filter. This issue is fixed in 50.0.0.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:H/AT:P/PR:N/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":8.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-69247","epss":0.00175,"percentile":0.07333,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-69247","cwe":"CWE-208","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2026-69247","cwe":"CWE-209","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"cryptography","version":"49.0.0"}},"found":{"vulnerabilityID":"GHSA-g6cj-pr64-35w5","versionConstraint":">=44.0.0,<50.0.0 (python)"},"fix":{"suggestedVersion":"50.0.0"}}],"artifact":{"id":"pkg:pypi/cryptography@49.0.0?package-id=4fd4954f9a31099b","name":"cryptography","version":"49.0.0","type":"python","locations":[{"path":"/poetry.lock","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:cryptography.io:cryptography:49.0.0:*:*:*:*:python:*:*","cpe:2.3:a:cryptography.io:cryptography:49.0.0:*:*:*:*:*:*:*"],"purl":"pkg:pypi/cryptography@49.0.0","upstreams":[]}},{"vulnerability":{"id":"GHSA-gc5v-m9x4-r6x2","dataSource":"https://github.com/advisories/GHSA-gc5v-m9x4-r6x2","namespace":"github:language:python","severity":"Medium","urls":["https://github.com/psf/requests/security/advisories/GHSA-gc5v-m9x4-r6x2","https://github.com/psf/requests/commit/66d21cb07bd6255b1280291c4fafb71803cdb3b7","https://github.com/psf/requests/releases/tag/v2.33.0","https://nvd.nist.gov/vuln/detail/CVE-2026-25645"],"description":"Requests has Insecure Temp File Reuse in its extract_zipped_paths() utility function","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:L/UI:R/S:U/C:N/I:H/A:N","metrics":{"baseScore":4.4,"exploitabilityScore":0.8,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-25645","epss":0.00182,"percentile":0.08119,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-25645","cwe":"CWE-377","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["2.33.0"],"state":"fixed","available":[{"version":"2.33.0","date":"2026-03-26","kind":"first-observed"}]},"advisories":[],"risk":0.08554},"relatedVulnerabilities":[{"id":"CVE-2026-25645","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-25645","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/psf/requests/commit/66d21cb07bd6255b1280291c4fafb71803cdb3b7","https://github.com/psf/requests/releases/tag/v2.33.0","https://github.com/psf/requests/security/advisories/GHSA-gc5v-m9x4-r6x2"],"description":"Requests is a HTTP library. Prior to version 2.33.0, the `requests.utils.extract_zipped_paths()` utility function uses a predictable filename when extracting files from zip archives into the system temporary directory. If the target file already exists, it is reused without validation. A local attacker with write access to the temp directory could pre-create a malicious file that would be loaded in place of the legitimate one. Standard usage of the Requests library is not affected by this vulnerability. Only applications that call `extract_zipped_paths()` directly are impacted. Starting in version 2.33.0, the library extracts files to a non-deterministic location. If developers are unable to upgrade, they can set `TMPDIR` in their environment to a directory with restricted write access.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:N/I:H/A:N","metrics":{"baseScore":5.5,"exploitabilityScore":1.9,"impactScore":3.6},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:L/AC:H/PR:L/UI:R/S:U/C:N/I:H/A:N","metrics":{"baseScore":4.4,"exploitabilityScore":0.8,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-25645","epss":0.00182,"percentile":0.08119,"date":"2026-08-21"}],"cwes":[{"cve":"CVE-2026-25645","cwe":"CWE-377","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"requests","version":"2.32.5"}},"found":{"vulnerabilityID":"GHSA-gc5v-m9x4-r6x2","versionConstraint":"<2.33.0 (python)"},"fix":{"suggestedVersion":"2.33.0"}}],"artifact":{"id":"pkg:pypi/requests@2.32.5?package-id=fa7962f4f8afd080","name":"requests","version":"2.32.5","type":"python","locations":[{"path":"/poetry.lock","accessPath":""}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python:requests:2.32.5:*:*:*:*:*:*:*"],"purl":"pkg:pypi/reques